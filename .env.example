# Capital One Nessie (https://api.nessieisreal.com)
NESSIE_API_KEY=
# Optional default customer for single-tenant deploys (enables "Continue as Maya (demo)")
NESSIE_CUSTOMER_ID=
# NESSIE_API_BASE=https://api.nessieisreal.com

# xAI Grok (https://console.x.ai)
XAI_API_KEY=
XAI_CHAT_MODEL=grok-3-mini-fast
XAI_IMAGINE_MODEL=grok-imagine-image

# Demo only — never enable in production
POLARIS_USE_FIXTURE=false
DEMO_MODE=false

# Upstash Redis (Vercel KV integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Frontend mock mode (fixtures + demo panel)
NEXT_PUBLIC_USE_FIXTURES=true
NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_VOICE_MODE=fallback
